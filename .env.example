# Copy to .env.local to override locally. Only app/config.ts reads these.

# Public path the app is served from. "/" for most hosts; "/HairLondon/" on GitHub Pages.
VITE_BASE=/

# "hash" works on any static host with no server rewrites (URLs look like /#/stylists).
# "browser" gives clean URLs but the host must fall back to index.html for unknown paths.
VITE_ROUTER_MODE=hash

# Unused until a real backend exists.
# VITE_API_URL=

# Read by scripts/postbuild.ts. One of: pages | netlify | vercel | static
# DEPLOY_TARGET=static
